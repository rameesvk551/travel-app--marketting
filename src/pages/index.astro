---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const modules = [
  { number: '01', title: 'Lead management & CRM', tag: 'SALES PIPELINE', copy: 'Capture enquiries from WhatsApp, Instagram, your website and calls. Assign owners, track stages, schedule follow-ups and keep traveller details with each customer.', image: '/images/wayon-feature-leads.jpg', imageAlt: 'Wayon leads screen from the product brochure, shown on desktop and mobile', imageCaption: 'WAYON / LEADS · SAMPLE DATA', color: 'coral' },
  { number: '02', title: 'WhatsApp campaigns', tag: 'BULK MARKETING', copy: 'Organize opted-in contacts and prepare targeted bulk campaign messages for offers, seasonal packages and follow-ups.', image: '/images/wayon-feature-followups.jpg', imageAlt: 'Wayon follow-up queue shown on desktop and mobile', imageCaption: 'WAYON / FOLLOW-UPS · SAMPLE DATA', color: 'blue' },
  { number: '03', title: 'Quotes & itineraries', tag: 'SALES', copy: 'Build a route, add line items and send a clear quote using reusable templates and INR pricing.', image: '/images/wayon-feature-quotes.jpg', imageAlt: 'Wayon quotation builder for creating a trip quote', imageCaption: 'WAYON / QUOTATIONS · SAMPLE DATA', color: 'green' },
  { number: '04', title: 'Bookings & packages', tag: 'RESERVATIONS', copy: 'See reservations by status alongside what has been collected and what is still due.', image: '/images/wayon-feature-bookings.jpg', imageAlt: 'Wayon booking list showing revenue, payments due and reservation status', imageCaption: 'WAYON / BOOKINGS · SAMPLE DATA', color: 'purple' },
  { number: '05', title: 'Accounts & finance', tag: 'ACCOUNTS', copy: 'Issue invoices, record receipts, follow customer balances, review vendor payables and track financial reports.', image: '/images/wayon-feature-accounts.jpg', imageAlt: 'Wayon accounting overview with receipts, payables and ledger entries', imageCaption: 'WAYON / ACCOUNTING · SAMPLE DATA', color: 'yellow' },
  { number: '06', title: 'Trip operations & suppliers', tag: 'ON THE GROUND', copy: 'Keep itineraries, hotel confirmations, pickup details, supplier contacts and traveller documents with each trip.', image: '/images/wayon-feature-trips.jpg', imageAlt: 'Wayon package operations screen with customer receivables, vendor payables and trip finance', imageCaption: 'WAYON / OPERATIONS · SAMPLE DATA', color: 'mint' },
  { number: '07', title: 'HRM & attendance', tag: 'PEOPLE', copy: 'Keep staff profiles, daily attendance, leave and payroll information together for your travel team.', image: '/images/wayon-feature-hrm.jpg', imageAlt: 'Wayon HRM screen with attendance, leave and staff timesheets', imageCaption: 'WAYON / HRM · SAMPLE DATA', color: 'coral' },
  { number: '08', title: 'Website builder', tag: 'YOUR BRAND', copy: 'Show your packages under your own agency brand and give visitors a direct route to enquire.', image: '/images/munnar-tea.jpg', imageAlt: 'Illustrative Kerala package page image for an agency website', imageCaption: 'BRANDED PACKAGE PAGE · EXAMPLE', websiteExample: true, color: 'blue' },
];

const faqs = [
  ['Who is Wayon for?', 'Wayon is built for travel agencies and tour operators that manage enquiries, package bookings and day-to-day trip operations.'],
  ['Can I use my own brand on my website?', 'The website builder section is designed around your agency identity, so your packages can be presented under your own brand.'],
  ['Can Wayon collect booking requests?', 'Yes. An agency can collect booking requests from its website and manage them in Wayon. This marketing page is a static demo; its form only opens an email draft and is not connected to a live booking system.'],
  ['Can I manage sales and trip delivery?', 'The workspace covers lead management, WhatsApp campaigns, quotations, package bookings, accounts, HRM and trip details.'],
];
---

<BaseLayout title="Home" description="Run your travel business in one place with Wayon: travel CRM, booking management, trip operations, supplier tools and a branded website builder." image="/favicon.svg">
  <Header />
  <main>
    <section class="erp-hero" id="top">
      <div class="hero-orb hero-orb-one"></div><div class="hero-orb hero-orb-two"></div>
      <div class="erp-wrap hero-layout">
        <div class="hero-copy">
          <div class="eyebrow"><span class="eyebrow-dot"></span> THE TRAVEL AGENCY WORKSPACE</div>
          <h1>Your whole travel desk.<br /><span>Finally in sync.</span></h1>
          <p class="hero-lede">Move from the first enquiry to the final pickup with CRM, WhatsApp follow-ups, bookings, accounts and your team in one place.</p>
          <div class="hero-actions">
            <a class="button button-dark" href="#demo">Book a Wayon walkthrough <span aria-hidden="true">↗</span></a>
            <a class="button button-light" href="#platform">See the platform <span aria-hidden="true">↓</span></a>
          </div>
          <div class="hero-note"><span class="note-check">✳</span> Built around how travel teams actually work</div>
        </div>

        <div class="hero-visual">
          <figure class="hero-travel-photo"><img src="/images/munnar-tea.jpg" alt="Rolling tea gardens in Munnar, Kerala" fetchpriority="high" /><figcaption><span>THE JOURNEY IS THE PRODUCT</span><span>KERALA · INDIA</span></figcaption></figure>
          <figure class="hero-product-screen">
            <img src="/images/wayon-crm-dashboard.png" alt="Wayon Leads, showing the enquiry pipeline on desktop and mobile" loading="lazy" />
            <figcaption><span>WAYON / LEADS</span><span>YOUR WORK, CONNECTED</span></figcaption>
          </figure>
          <div class="hero-stamp"><span>FROM FIRST ENQUIRY</span><strong>TO FINAL PICKUP</strong><i aria-hidden="true">↗</i></div>
        </div>
      </div>
      <div class="hero-bottom"><div class="erp-wrap hero-bottom-inner"><span>ONE CONNECTED WORKSPACE</span><div>Enquiries <b>→</b> Quotes <b>→</b> Bookings <b>→</b> Operations <b>→</b> Finance</div><a href="#platform">See what’s inside <span>↓</span></a></div></div>
    </section>

    <section class="intro-section erp-wrap" id="platform">
      <div class="section-kicker">YOUR WHOLE DESK, IN SYNC</div>
  <div class="intro-grid"><h2>A trip has a lot of moving parts.<br /><span>Keep them together.</span></h2><p>Bring lead management, WhatsApp campaigns, bookings, accounts and HRM into the same travel workspace. Sales and operations can pick up the same traveller and trip details as work moves forward.</p></div>
      <div class="module-grid">
        {modules.map((module) => <article class={`module-card module-${module.color}${module.websiteExample ? ' module-website-example' : ''}`}><figure class="module-shot"><img src={module.image} alt={module.imageAlt} loading="lazy" /><figcaption>{module.imageCaption}</figcaption></figure><div class="module-content"><div class="module-meta"><span class="module-number">{module.number}</span><span class="module-tag">{module.tag}</span></div><h3>{module.title}</h3><p>{module.copy}</p><a href="#workflow" aria-label={`Learn about ${module.title}`}>Explore module <span>↗</span></a></div></article>)}
      </div>
    </section>

    <section class="workflow-section" id="workflow"><div class="erp-wrap workflow-grid"><div class="workflow-copy"><div class="section-kicker">THE DETAILS TRAVEL WITH THE BOOKING.</div><h2>When the booking changes,<br /><span>the whole team knows.</span></h2><p>A booking should not need to be explained twice. Keep the original request, revised quote, supplier replies and final itinerary on the same trip.</p><a class="text-link" href="#demo">Explore the trip flow <span>↗</span></a><div class="workflow-steps"><div class="step active"><span>01</span><div><strong>Capture the enquiry</strong><small>Save dates, budget, room requests and who needs to call back.</small></div></div><div class="step"><span>02</span><div><strong>Shape the proposal</strong><small>Send the quote and record each change without losing the old version.</small></div></div><div class="step"><span>03</span><div><strong>Confirm the booking</strong><small>Keep passenger details, advances, confirmations and documents together.</small></div></div><div class="step"><span>04</span><div><strong>Deliver the journey</strong><small>Share pickup times and supplier contacts before the first departure.</small></div></div></div></div>
        <figure class="product-screen product-screen-wide"><img src="/images/wayon-bookings.png" alt="Wayon booking list with paid, due, and booking status columns" loading="lazy" /><figcaption><span>WAYON / BOOKINGS</span><span>COLLECTIONS AND STATUS · SAMPLE DATA</span></figcaption></figure>
      </div></section>

    <section class="website-section" id="website-builder"><div class="erp-wrap website-grid"><div class="website-copy"><div class="section-kicker">YOUR BRAND, YOUR FRONT DOOR</div><h2>Your packages,<br /><span>on your own site.</span></h2><p>Give a traveller somewhere to browse the journeys you sell, see the details and send an enquiry. Keep the pages in your agency’s name.</p><ul><li><span>✓</span> Put your agency name and contact details up front</li><li><span>✓</span> Show the route, duration and what is included</li><li><span>✓</span> Give each package a direct enquiry path</li><li><span>✓</span> Update your offer when seasons or rates change</li></ul><a class="button button-dark" href="#demo">See a website example <span>↗</span></a></div><div class="site-preview"><div class="preview-top"><span class="browser-dots"><i></i><i></i><i></i></span><div class="address-bar">malabartrail.example / kerala</div><span>↗</span></div><div class="preview-page"><div class="preview-nav"><span class="preview-logo"><i>m</i> Malabar Trail Co.</span><span>Kerala trips &nbsp;&nbsp; About &nbsp;&nbsp; Contact</span><button>Ask about this trip ↗</button></div><div class="preview-hero"><div class="preview-image"><img src="/images/munnar-tea.jpg" alt="Tea gardens across the hills of Munnar" /><div class="landscape-caption"><small>KERALA · 7 DAYS</small><strong>From the hills<br />to the backwaters.</strong><span>Kochi · Munnar · Alappuzha</span></div></div><div class="preview-story"><div class="preview-eyebrow">A PRIVATE KERALA JOURNEY</div><h3>Take the long way.</h3><p>Tea country mornings, an easy drive south and a night on the water.</p><button>View the route <span>→</span></button></div></div><div class="preview-bottom"><span>7 DAYS / 6 NIGHTS</span><span>PRIVATE DRIVER · TWO STAYS</span><span>ASK FOR DATES</span><small>PHOTO: ROHIT DEY / UNSPLASH</small></div></div><div class="builder-float"><span>✳</span><div><strong>Made for your brand</strong><small>Packages · Enquiries · Pages</small></div></div></div></div></section>

    <section class="closing-section"><div class="erp-wrap closing-inner"><div><div class="section-kicker">GOOD TRIPS TAKE A TEAM</div><h2>Less time checking three places.<br /><span>More time with the traveller.</span></h2><p>Bring one of your current trip workflows. We’ll show where the enquiry, booking and operations fit.</p></div><a href="#demo" class="button button-lime">Let’s talk about your workflow <span>↗</span></a></div></section>

    <section class="faq-section erp-wrap" id="faq"><div class="faq-intro"><div class="section-kicker">A FEW GOOD QUESTIONS</div><h2>Before we<br /><span>take off.</span></h2><p>Want to see how the pieces fit together? Start with the basics, then tell us how your team works.</p></div><div class="faq-list">{faqs.map(([question, answer], i) => <details class="faq-row" open={i === 0}><summary>{question}<span>+</span></summary><p>{answer}</p></details>)}</div></section>

    <section class="demo-section" id="demo"><div class="erp-wrap demo-grid"><div><div class="section-kicker">LET’S MAP YOUR WORKFLOW</div><h2>Show us how your<br /><span>travel desk works.</span></h2><p>Tell us what your team sells and where the handoffs get stuck. Your email app will open with a draft for a Wayon walkthrough.</p><div class="demo-promise"><span>✳</span><div><strong>Made for travel teams</strong><small>Agencies · Tour operators · DMCs</small></div></div></div><form class="demo-form" id="demo-form"><label>Your name<input name="name" autocomplete="name" placeholder="e.g. Alex Rivera" required /></label><label>Work email<input type="email" name="email" autocomplete="email" placeholder="you@youragency.com" required /></label><label>What would you like to manage?<select name="interest"><option>Lead management and CRM</option><option>WhatsApp bulk marketing</option><option>Bookings and accounts</option><option>HRM and attendance</option><option>Trip operations</option><option>Agency website builder</option><option>Everything in one place</option></select></label><button type="submit" class="button button-dark">Request a conversation <span>↗</span></button><small class="form-note">This static demo opens a prefilled email draft. No form data is stored on this page.</small></form></div></section>
  </main>
  <Footer />
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#demo-form');
  form?.addEventListener('submit', (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const subject = encodeURIComponent(`Wayon demo request — ${data.get('interest')}`);
    const body = encodeURIComponent(`Hi Wayon,\n\nI'd like to learn more about the travel ERP.\n\nName: ${data.get('name')}\nWork email: ${data.get('email')}\nInterested in: ${data.get('interest')}\n`);
    window.location.href = `mailto:hello@wayon.travel?subject=${subject}&body=${body}`;
  });
</script>
